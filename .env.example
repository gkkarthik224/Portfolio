# Copy to .env if needed. No API credentials are required for tests or qa:audit.
# Leave unset to start an isolated Python server at http://127.0.0.1:8765.
# PORTFOLIO_BASE_URL=http://127.0.0.1:8080
QA_WORKERS=2
# QA_CROSS_BROWSER=1
# STRICT_AUDIT=1

# qa:ai explicitly sends the captured portfolio text to the OpenAI API.
# Set both values before running it; choose a model supporting Structured Outputs.
# OPENAI_API_KEY=
# OPENAI_MODEL=
AI_MAX_OUTPUT_TOKENS=6000
